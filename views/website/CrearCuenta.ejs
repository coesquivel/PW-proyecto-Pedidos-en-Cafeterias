<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear cuenta - Campus Pide</title>

  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Estilos embebidos directamente para garantizar la carga -->
  <style>
    :root {
      --bg-beige: #f8f4f0;
      --primary-red: #d93d2a;
      --primary-red-hover: #b83020;
      --card-info-bg: #faede8;
      --label-color: #6d625b;
      --border-muted: #e5dad1;
    }

    /* Fondo general de la página */
    html, body {
      background-color: var(--bg-beige) !important;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      color: #333333;
    }

    /* Navbar superior blanca */
    .top-navbar {
      background-color: #ffffff;
      border-bottom: 1px solid #eae2db;
    }

    /* Tarjeta principal del formulario */
    .custom-card {
      border-radius: 20px !important;
      background-color: #ffffff !important;
      border: none !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03) !important;
    }

    /* Tarjeta informativa derecha */
    .info-card {
      background-color: var(--card-info-bg) !important;
      border-radius: 20px !important;
      border: none !important;
    }

    /* Etiquetas de inputs */
    .custom-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--label-color);
      margin-bottom: 0.35rem;
    }

    /* Campos de texto */
    .custom-input {
      border-radius: 12px !important;
      padding: 0.65rem 0.9rem;
      font-size: 0.88rem;
      border: 1px solid var(--border-muted) !important;
      background-color: #ffffff;
    }

    .custom-input:focus {
      border-color: var(--primary-red) !important;
      box-shadow: 0 0 0 0.2rem rgba(217, 61, 42, 0.12) !important;
    }

    /* Checkbox personalizado */
    .form-check-input:checked {
      background-color: var(--primary-red);
      border-color: var(--primary-red);
    }

    /* Botón Principal (Rojo) */
    .btn-danger-custom {
      background-color: var(--primary-red) !important;
      border-color: var(--primary-red) !important;
      color: #ffffff !important;
      border-radius: 12px !important;
      padding: 0.65rem 1.4rem;
      font-size: 0.88rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-danger-custom:hover {
      background-color: var(--primary-red-hover) !important;
      border-color: var(--primary-red-hover) !important;
    }

    /* Botón Secundario (Blanco con borde) */
    .btn-outline-custom {
      background-color: #ffffff !important;
      border: 1px solid var(--border-muted) !important;
      color: #222222 !important;
      border-radius: 12px !important;
      padding: 0.65rem 1.4rem;
      font-size: 0.88rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-outline-custom:hover {
      background-color: #f3eae3 !important;
    }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Barra de Navegación -->
  <header class="top-navbar py-3 px-4 mb-4">
<%- include('partials/Login/_navbar') %>
  </header>

  <!-- Contenido Central -->
  <main class="container mb-5 flex-grow-1" style="max-width: 1100px;">
    
    <!-- Miga de pan / Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb small text-muted">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Inicio</a></li>
        <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Crear cuenta</li>
      </ol>
    </nav>

    <div class="row g-4">
      
      <!-- Columna Izquierda: Formulario -->
      <div class="col-12 col-lg-7">
        <div class="card custom-card p-4 p-md-5">
          <h1 class="h3 fw-bold mb-1 text-dark">Crea tu cuenta</h1>
          <p class="text-muted small mb-4">Solo se admiten correos de la Universidad de Lima.</p>

          <form action="/register" method="POST">
            <!-- Nombres y Apellidos -->
            <div class="row g-3 mb-3">
              <div class="col-12 col-md-6">
                <label for="nombres" class="form-label custom-label">NOMBRES</label>
                <input type="text" id="nombres" name="nombres" class="form-control custom-input" placeholder="Mateo Alonso">
              </div>
              <div class="col-12 col-md-6">
                <label for="apellidos" class="form-label custom-label">APELLIDOS</label>
                <input type="text" id="apellidos" name="apellidos" class="form-control custom-input" placeholder="Rojas Ibáñez">
              </div>
            </div>

            <!-- Correo Institucional -->
            <div class="mb-3">
              <label for="correo" class="form-label custom-label">CORREO INSTITUCIONAL</label>
              <input type="email" id="correo" name="correo" class="form-control custom-input" placeholder="nombre@aloe.ulima.edu.pe">
              <div class="form-text text-muted small mt-1">Te enviaremos un enlace de verificación a este correo.</div>
            </div>

            <!-- Contraseña y Confirmación -->
            <div class="row g-3 mb-1">
              <div class="col-12 col-md-6">
                <label for="password" class="form-label custom-label">CONTRASEÑA</label>
                <input type="password" id="password" name="password" class="form-control custom-input" placeholder="••••••••">
              </div>
              <div class="col-12 col-md-6">
                <label for="confirmPassword" class="form-label custom-label">CONFIRMAR CONTRASEÑA</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control custom-input" placeholder="••••••••">
              </div>
            </div>
            <div class="form-text text-muted small mb-4">Mínimo 8 caracteres, con una mayúscula y un número.</div>

            <!-- Teléfono -->
            <div class="mb-4" style="max-width: 280px;">
              <label for="telefono" class="form-label custom-label">TELÉFONO</label>
              <input type="tel" id="telefono" name="telefono" class="form-control custom-input" placeholder="987 654 321">
              <div class="form-text text-muted small mt-1">Lo usamos para avisarte cuando tu pedido esté listo.</div>
            </div>

            <!-- Términos -->
            <div class="form-check mb-4">
              <input class="form-check-input" type="checkbox" id="terminos" required>
              <label class="form-check-label small text-muted" for="terminos">
                Acepto los términos del servicio y el tratamiento de mis datos personales.
              </label>
            </div>

            <!-- Botones -->
            <div class="d-flex flex-wrap gap-2">
              <button type="submit" class="btn btn-danger-custom">Crear cuenta</button>
              <a href="/login" class="btn btn-outline-custom text-decoration-none">Ya tengo cuenta</a>
            </div>
          </form>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta Informativa -->
      <div class="col-12 col-lg-5">
        <div class="card info-card p-4">
          <h2 class="h5 fw-bold mb-3 text-dark">Con tu cuenta puedes</h2>
          
          <ul class="list-unstyled small text-secondary mb-4 d-flex flex-column gap-3">
            <li class="d-flex align-items-start gap-2">
              <span class="text-success fw-bold">✓</span>
              <span>Pedir con anticipación en los cinco locales del campus.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
              <span class="text-success fw-bold">✓</span>
              <span>Elegir la hora de recojo y seguir el avance de tu pedido.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
              <span class="text-success fw-bold">✓</span>
              <span>Repetir pedidos anteriores en un paso.</span>
            </li>
            <li class="d-flex align-items-start gap-2">
              <span class="text-success fw-bold">✓</span>
              <span>Calificar los locales y los productos que consumes.</span>
            </li>
          </ul>

          <div class="bg-white p-3 rounded-3 text-muted" style="font-size: 0.78rem; line-height: 1.4;">
            El pago siempre se realiza en el punto de recojo. La plataforma no guarda datos de tarjetas.
          </div>
        </div>
      </div>

    </div>
  </main>
    <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>