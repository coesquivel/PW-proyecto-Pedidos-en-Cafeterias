<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Iniciar Sesión - Campus Pide</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Login/_navbarL.css">
    <link rel="stylesheet" href="/assets/css/Login/_footerL.css">
    <link rel="stylesheet" href="/assets/css/Login/_home.css">
</head>

<body>
    <!-- NAVBAR -->
    <%- include('partials/Login/_navbar') %>
    <!-- LOGIN -->
    <div class="login-wrapper">

        <!-- Columna izquierda -->
        <div class="login-left col-lg-6">

            <div class="login-left-content">

                <h1>
                    Tu pedido listo a la hora que elijas
                </h1>

                <p>
                    Ingresa con tu correo institucional para pedir en los locales
                    del campus y seguir tus pedidos en curso.
                </p>

                <div class="login-img-container">
                    <img
                        src="assets/img/cafeteria.png"
                        alt="Login"
                        class="img-fluid"
                    >
                </div>

            </div>
        </div>

        <!-- Columna derecha -->
        <div class="login-right col-lg-6">

            <div class="login-card">
                <h2>
                    Inicia sesión
                </h2>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="correo" class="form-label-custom">
                            Correo Institucional
                        </label>

                        <input
                            type="email"
                            id="correo"
                            name="correo"
                            class="form-control-custom"
                            placeholder="tucorreo@aloe.ulima.edu.pe"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label
                            for="password"
                            class="form-label-custom"
                        >
                            Contraseña
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control-custom"
                            placeholder="••••••••"
                            required
                        >
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="form-check m-0">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="remember"
                                name="remember"
                            >

                            <label
                                class="form-check-label"
                                for="remember"
                            >
                                Recordarme
                            </label>
                        </div>

                        <a href="#" class="forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>

                    </div>

                    <button type="submit" class="btn-submit" id="btnIngresarXLogin">
                        Ingresar
                    </button>

                    <p class="register-text">
                        ¿No tienes cuenta?
                        <a href="/register">
                            Crear cuenta
                        </a>
                    </p>

                </form>

            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>

    <!-- Bootstrap JS -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->

</body>
</html>