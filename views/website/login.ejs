<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Iniciar Sesión - Campus Pide</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tipografía del sistema de diseño -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <!-- Navbar compartido: el mismo de home -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Login/_footerL.css">
    <link rel="stylesheet" href="/assets/css/Login/_home.css">

    <style>
        /* Tokens compartidos con home / comoFunciona (el navbar los usa) */
        :root {
            --primary: #DF402F;
            --primary-dark: #AB3024;
            --primary-soft: #FCEAE7;
            --accent: #5B9B2E;
            --accent-soft: #EEF5E7;
            --bg: #FFFBF8;
            --rojo: #df3d2e;
            --rojo-hover: #c83225;
            --surface: #FFFFFF;
            --border: #EFE2DC;
            --text: #261915;
            --text-muted: #7C6960;
            --success: #5B9B2E;
            --warning: #B7791F;
            --danger: #B4322B;
            --info: #3B6FA8;
            --radius: 12px;
            --shadow: 0 4px 16px rgba(38, 25, 21, 0.035);
        }

        /* Siempre reserva el espacio de la barra de scroll, igual que home,
           para que el navbar quede alineado aunque esta página sea corta. */
        html {
            overflow-y: scroll;
        }
    </style>
</head>

<body>
    <!-- NAVBAR COMPARTIDO (igual que home) -->
    <%- include('partials/Home/_navbar') %>
    <!-- LOGIN -->
    <div class="login-wrapper">

        <!-- Columna izquierda -->
        <div class="login-left col-lg-6">

            <div class="login-left-content">

                <h1>
                    Tu pedido listo a la hora que elijas
                </h1>

                <p>
                    Ingresa con tu correo institucional para pedir en los locales
                    del campus y seguir tus pedidos en curso.
                </p>

                <div class="login-img-container">
                    <img
                        src="assets/img/cafeteria.png"
                        alt="Login"
                        class="img-fluid"
                    >
                </div>

            </div>
        </div>

        <!-- Columna derecha -->
        <div class="login-right col-lg-6">

            <div class="login-card">
                <h2>
                    Inicia sesión
                </h2>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="correo" class="form-label-custom">
                            Correo Institucional
                        </label>

                        <input
                            type="email"
                            id="correo"
                            name="correo"
                            class="form-control-custom"
                            placeholder="tucorreo@aloe.ulima.edu.pe"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label
                            for="password"
                            class="form-label-custom"
                        >
                            Contraseña
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control-custom"
                            placeholder="••••••••"
                            required
                        >
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div class="form-check m-0">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="remember"
                                name="remember"
                            >

                            <label
                                class="form-check-label"
                                for="remember"
                            >
                                Recordarme
                            </label>
                        </div>

                        <a href="RecuperarContrasena" class="forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>

                    </div>

                    <button type="submit" class="btn-submit" id="btnIngresarXLogin">
                        Ingresar
                    </button>

                    <p class="register-text">
                        ¿No tienes cuenta?
                        <a href="/register">
                            Crear cuenta
                        </a>
                    </p>

                </form>

            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>

    <!-- Bootstrap JS -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->

</body>
</html>