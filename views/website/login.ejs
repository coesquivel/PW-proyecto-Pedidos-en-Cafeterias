<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Iniciar Sesión - Campus Pide</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tipografía del sistema de diseño -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Login/_footerL.css">
    <link rel="stylesheet" href="/assets/css/Login/_home.css">
    <link rel="stylesheet" href="/assets/css/Login/_login.css">
</head>

<body>
    <!-- NAVBAR COMPARTIDO -->
    <%- include('partials/Home/_navbar') %>

    <!-- LOGIN -->
    <div class="login-wrapper">

        <!-- Columna izquierda -->
        <div class="login-left col-lg-6">
            <div class="login-left-content">
                <h1>Tu pedido listo a la hora que elijas</h1>
                <p>
                    Ingresa con tu correo institucional para pedir en los locales
                    del campus y seguir tus pedidos en curso.
                </p>
                <div class="login-img-container">
                    <img
                        src="/assets/img/cafeteria.png"
                        alt="Login"
                        class="img-fluid"
                    >
                </div>
            </div>
        </div>

        <!-- Columna derecha -->
        <div class="login-right col-lg-6">
            <div class="login-card">
                <h2>Inicia sesión</h2>

                <!-- Detecta si viene error desde el servidor -->
                <% const msgError = locals.error || locals.mensaje; %>

                <% if (msgError) { %>
                    <div class="login-alert-error">
                        <%= msgError === 'No encontrado' ? 'Correo o contraseña incorrectos. Te quedan 4 intentos.' : msgError %>
                    </div>
                <% } %>

                <form action="/login" method="POST" id="formLogin">
                    <div class="mb-3">
                        <label for="correo" class="form-label-custom">
                            Correo Institucional
                        </label>
                        <input
                            type="email"
                            id="correo"
                            name="correo"
                            class="form-control-custom"
                            placeholder="tucorreo@aloe.ulima.edu.pe"
                            value="<%= locals.correoIngresado || '' %>"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label-custom">
                            Contraseña
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control-custom <%= msgError ? 'input-error' : '' %>"
                            placeholder="••••••••"
                            required
                        >
                        <% if (msgError) { %>
                            <span class="login-error-msg">Verifica tus datos e inténtalo otra vez.</span>
                        <% } %>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check m-0">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="remember"
                                name="remember"
                            >
                            <label class="form-check-label" for="remember">
                                Recordarme
                            </label>
                        </div>

                        <a href="RecuperarContrasena" class="forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button type="submit" class="btn-submit" id="btnSubmitLogin">
                        <span class="btn-spinner" id="loginSpinner"></span>
                        <span id="btnText">Ingresar</span>
                    </button>

                    <p class="info-validando" id="infoValidando" style="display: none;">
                        Campos y enlaces deshabilitados mientras se valida.
                    </p>

                    <p class="register-text">
                        ¿No tienes cuenta?
                        <a href="/register">Crear cuenta</a>
                    </p>
                </form>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>

    <!-- Script de validación y estados visuales -->
    <script>
        // Si el usuario intenta volver atrás con la flecha del navegador, fuerza al servidor a redirigirlo
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });

        const formLogin = document.getElementById('formLogin');
        const btnSubmit = document.getElementById('btnSubmitLogin');
        const spinner = document.getElementById('loginSpinner');
        const btnText = document.getElementById('btnText');
        const infoValidando = document.getElementById('infoValidando');
        const inputCorreo = document.getElementById('correo');
        const inputPassword = document.getElementById('password');

        let intentosRestantes = 4;

        formLogin.addEventListener('submit', async function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            // 1. Limpiar mensajes de error previos
            const alertaPrevia = document.querySelector('.login-alert-error');
            const msgPrevio = document.querySelector('.login-error-msg');
            if (alertaPrevia) alertaPrevia.remove();
            if (msgPrevio) msgPrevio.remove();
            inputPassword.classList.remove('input-error');

            // 2. Mostrar estado "Ingresando..."
            inputCorreo.readOnly = true;
            inputPassword.readOnly = true;
            inputCorreo.classList.add('input-loading');
            inputPassword.classList.add('input-loading');

            btnSubmit.classList.add('btn-loading');
            spinner.style.display = 'inline-block';
            btnText.textContent = 'Ingresando...';
            infoValidando.style.display = 'block';

            // Pausa de 700ms para que se vea la animación de carga
            await new Promise(resolve => setTimeout(resolve, 700));

            // 3. Enviar petición al controlador (POST /login)
            try {
                const bodyData = new URLSearchParams({
                    correo: inputCorreo.value.trim(),
                    password: inputPassword.value
                });

                const response = await fetch('/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: bodyData.toString(),
                    redirect: 'follow'
                });

                // Si las credenciales son válidas, replace() borra /login del historial
                if (response.redirected && !response.url.endsWith('/login')) {
                    window.location.replace(response.url);
                    return;
                }

                // Si no redirigió, las credenciales son incorrectas
                mostrarErrorCredenciales();
            } catch (err) {
                mostrarErrorCredenciales();
            }
        });

        function mostrarErrorCredenciales() {
            inputCorreo.readOnly = false;
            inputPassword.readOnly = false;
            inputCorreo.classList.remove('input-loading');
            inputPassword.classList.remove('input-loading');

            btnSubmit.classList.remove('btn-loading');
            spinner.style.display = 'none';
            btnText.textContent = 'Ingresar';
            infoValidando.style.display = 'none';

            inputPassword.classList.add('input-error');

            const alertBox = document.createElement('div');
            alertBox.className = 'login-alert-error';
            alertBox.textContent = `Correo o contraseña incorrectos. Te quedan ${intentosRestantes} intentos.`;
            formLogin.parentNode.insertBefore(alertBox, formLogin);

            const spanError = document.createElement('span');
            spanError.className = 'login-error-msg';
            spanError.textContent = 'Verifica tus datos e inténtalo otra vez.';
            inputPassword.parentNode.appendChild(spanError);

            if (intentosRestantes > 1) intentosRestantes--;
        }
    </script>

</body>

</html>