<!doctype html>
<html lang="es">
<head>
  <!-- Bootstrap 5 CDN -->

 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- CSS -->

  <link rel="stylesheet" href="/assets/css/Login/_navbarL.css">
  <link rel="stylesheet" href="/assets/css/Login/_footerL.css">
  <link rel="stylesheet" href="/assets/css/Login/_home.css">
  
 
  <style>
    :root {
      --bs-body-font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
      --bs-body-font-size: .875rem;
      --bs-body-color: #302522;
      --bs-body-bg: #fffaf8;
      --cp-red: #dc3d2d;
      --cp-red-dark: #c93427;
      --cp-muted: #78645e;
      --cp-line: #f0e5e1;
      --cp-green: #4f9d2d;
      --cp-amber: #e0a100;
    }
 
    .font-display { font-family: Poppins, Inter, sans-serif; }
 
    /* Botones */
    .btn-primary {
      --bs-btn-bg: var(--cp-red);
      --bs-btn-border-color: var(--cp-red);
      --bs-btn-hover-bg: var(--cp-red-dark);
      --bs-btn-hover-border-color: var(--cp-red-dark);
      --bs-btn-active-bg: var(--cp-red-dark);
      --bs-btn-active-border-color: var(--cp-red-dark);
      --bs-btn-disabled-bg: var(--cp-red);
      --bs-btn-disabled-border-color: var(--cp-red);
      --bs-btn-focus-shadow-rgb: 220, 61, 45;
      --bs-btn-border-radius: .5625rem;
      --bs-btn-font-size: .75rem;
      --bs-btn-font-weight: 700;
    }
    .btn-outline-cp {
      --bs-btn-color: var(--cp-red);
      --bs-btn-border-color: #f0a59c;
      --bs-btn-hover-color: var(--cp-red);
      --bs-btn-hover-bg: #fff5f2;
      --bs-btn-hover-border-color: var(--cp-red);
      --bs-btn-active-color: var(--cp-red);
      --bs-btn-active-bg: #fff5f2;
      --bs-btn-active-border-color: var(--cp-red);
      --bs-btn-border-radius: .6875rem;
      --bs-btn-padding-x: 1.05rem;
      --bs-btn-padding-y: .6rem;
      --bs-btn-font-size: .75rem;
      --bs-btn-font-weight: 600;
    }
    /* Botón secundario suave ("Reenviar enlace") */
    .btn-soft {
      --bs-btn-color: var(--bs-body-color);
      --bs-btn-bg: #fff;
      --bs-btn-border-color: #f0d5cf;
      --bs-btn-hover-color: var(--cp-red-dark);
      --bs-btn-hover-bg: #fff5f2;
      --bs-btn-hover-border-color: #e9b9b0;
      --bs-btn-active-bg: #fff5f2;
      --bs-btn-active-border-color: var(--cp-red);
      --bs-btn-disabled-color: var(--bs-body-color);
      --bs-btn-disabled-bg: #fff;
      --bs-btn-disabled-border-color: #f0d5cf;
      --bs-btn-disabled-opacity: .75;
      --bs-btn-border-radius: .5625rem;
      --bs-btn-font-size: .75rem;
      --bs-btn-font-weight: 600;
    }
    /* Indicador de pasos */
    .step { width: 24px; height: 24px; flex: 0 0 24px; border: 1px solid #eadbd5; background: #fff; color: #8c7770; font-size: .6875rem; transition: background .2s, border-color .2s, color .2s; }
    .step.active, .step.done { border-color: var(--cp-red); background: var(--cp-red); color: #fff; font-weight: 700; }
    .step-line { height: 1px; margin: 0 7px; background: #eadbd5; }
 
    /* Tarjeta */
    .recovery { width: min(100%, 464px); }
    .card-cp { padding: 24px 22px 20px; border: 1px solid #f0e8e4; border-radius: 13px; box-shadow: 0 7px 20px rgba(77, 44, 34, .08); }
    .card-cp h1 { font-size: 1.25rem; letter-spacing: -.35px; }
    .card-cp h1:focus { outline: none; }
    .intro { color: var(--cp-muted); font-size: .78rem; line-height: 1.55; }
    .hint { color: var(--cp-muted); font-size: .6875rem; }
 
    /* Formulario */
    .form-label { color: #6f5750; font-size: .625rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
    .form-control { height: 42px; border-color: var(--cp-line); border-radius: .5625rem; font-size: .75rem; }
    .form-control::placeholder { color: #9b8983; }
    .form-control:focus { border-color: #e27265; box-shadow: 0 0 0 3px rgba(220, 61, 45, .12); }
    .alert-cp { padding: 10px 12px; border: 0; border-radius: 8px; color: #8a342b; background: #fff2ef; font-size: .75rem; }
 
    /* Paso 2: icono */
    .icon-circle { width: 48px; height: 48px; border-radius: 50%; background: #fde6e1; color: var(--cp-red); }
 
    /* Paso 3: medidor de seguridad */
    .strength .progress { flex: 1; height: 4px; background: #eadbd5; border-radius: 4px; }
    .strength .progress-bar { width: 0; background: var(--cp-red); transition: width .25s, background-color .25s; }
    .strength-label { min-width: 44px; text-align: right; font-size: .6875rem; font-weight: 600; }
 
 
  </style>
</head>
<body class="min-vh-100 d-flex flex-column">
 
  <!-- Navbar -->
  <header class="navbar navbar-cp d-flex align-items-center gap-4">
    <a class="navbar-brand font-display fw-bold" href="/" aria-label="Campus Pide, inicio">Campus Pide</a>
    <nav class="d-none d-md-flex align-items-center gap-4" aria-label="Navegación principal">
      <a class="nav-link" href="/locales">Locales</a>
      <a class="nav-link" href="/como-funciona">Cómo funciona</a>
      <a class="nav-link" href="/registrar-local">Registrar mi local</a>
    </nav>
    <div class="ms-auto d-flex align-items-center gap-3 gap-md-4">
      <a class="link-cp" href="/iniciar-sesion">Iniciar sesión</a>
      <a class="btn btn-outline-cp" href="/crear-cuenta">Crear cuenta</a>
    </div>
  </header>
 
  <main class="flex-grow-1 d-flex align-items-center justify-content-center px-3 py-5">
    <section class="recovery">
 
      <!-- Indicador de pasos (se actualiza desde JS) -->
      <div id="stepper" class="d-flex align-items-center mb-3" aria-label="Paso 1 de 3">
        <span class="step active rounded-circle d-flex align-items-center justify-content-center" aria-current="step">1</span>
        <span class="step-line flex-grow-1"></span>
        <span class="step rounded-circle d-flex align-items-center justify-content-center">2</span>
        <span class="step-line flex-grow-1"></span>
        <span class="step rounded-circle d-flex align-items-center justify-content-center">3</span>
      </div>
 
      <div class="card card-cp bg-white">
 
        <!-- ============ PASO 1: Correo ============ -->
        <div data-panel="1">
          <h1 class="font-display fw-semibold mb-2" tabindex="-1">Recupera tu acceso</h1>
          <p class="intro mb-3">Ingresa tu correo institucional y te enviaremos un enlace para crear una contraseña nueva. El enlace expira en 60 minutos.</p>
 
          <form id="form-email" novalidate>
            <label for="email" class="form-label mb-2">Correo institucional</label>
            <input id="email" name="email" type="email" class="form-control" placeholder="nombre@aloe.ulima.edu.pe" autocomplete="email" required>
            <div class="invalid-feedback">Ingresa un correo institucional válido.</div>
            <button id="btn-send" class="btn btn-primary w-100 mt-3" style="min-height:42px" type="submit">Enviar enlace</button>
          </form>
 
          <p class="text-center mt-3 mb-0" style="font-size:.6875rem">
            <a class="link-cp" href="/iniciar-sesion" style="font-size:inherit">Volver al inicio de sesión</a>
          </p>
        </div>
 
        <!-- ============ PASO 2: Revisa tu correo ============ -->
        <div data-panel="2" class="text-center d-none">
          <div class="icon-circle d-flex align-items-center justify-content-center mx-auto mb-3" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </div>
          <h1 class="font-display fw-semibold mb-2" tabindex="-1">Revisa tu correo</h1>
          <p class="intro mb-3">
            Enviamos el enlace a <strong id="email-sent" class="fw-semibold" style="color:var(--bs-body-color)"></strong>.<br>
            Expira en 60 minutos.
          </p>
 
          <button id="btn-resend" type="button" class="btn btn-soft w-100" style="min-height:42px" disabled>Reenviar enlace</button>
          <p id="countdown" class="hint mt-3 mb-0" aria-live="polite">Podrás reenviarlo en 00:45</p>
        </div>
 
        <!-- ============ PASO 3: Nueva contraseña ============ -->
        <div data-panel="3" class="d-none">
          <h1 class="font-display fw-semibold mb-3" tabindex="-1">Crea tu contraseña nueva</h1>
 
          <form id="form-password" novalidate>
            <label for="password" class="form-label mb-2">Nueva contraseña</label>
            <input id="password" type="password" class="form-control" autocomplete="new-password" required>
            <p class="hint mt-2 mb-3">Mínimo 8 caracteres, con una mayúscula y un número.</p>
 
            <label for="password2" class="form-label mb-2">Confirmar contraseña</label>
            <input id="password2" type="password" class="form-control" autocomplete="new-password" required>
            <div id="password2-error" class="invalid-feedback">Las contraseñas no coinciden.</div>
 
            <div class="strength d-flex align-items-center gap-2 mt-3" aria-live="polite">
              <div class="progress" role="progressbar" aria-label="Seguridad de la contraseña" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="strength-bar" class="progress-bar"></div>
              </div>
              <span id="strength-label" class="strength-label"></span>
            </div>
 
            <button id="btn-save" class="btn btn-primary w-100 mt-3" style="min-height:42px" type="submit">Guardar contraseña</button>
          </form>
        </div>
 
        <!-- Mensajes generales (errores del servidor, éxito, reenvío) -->
        <div id="notice" class="alert alert-cp mt-3 mb-0 d-none" role="status" aria-live="polite"></div>
      </div>
    </section>
  </main>
 
  <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>
 
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    /* ===================== API (reemplazar por tu backend) ===================== */
    const MOCK = true; // Cambia a false cuando tengas los endpoints listos
 
    const api = {
      // Paso 1 y reenvío: genera el token y envía el correo
      async forgotPassword(email) {
        if (MOCK) return new Promise(r => setTimeout(r, 600));
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        if (!res.ok) throw new Error('No se pudo enviar el enlace.');
      },
      // Paso 3: guarda la nueva contraseña usando el token del enlace
      async resetPassword(token, password) {
        if (MOCK) return new Promise(r => setTimeout(r, 600));
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password })
        });
        if (!res.ok) throw new Error('El enlace expiró o ya fue usado. Solicita uno nuevo.');
      }
    };
 
    /* ===================== Navegación entre pasos ===================== */
    const panels  = [...document.querySelectorAll('[data-panel]')];
    const stepEls = [...document.querySelectorAll('#stepper .step')];
    const stepper = document.getElementById('stepper');
    const notice  = document.getElementById('notice');
 
    function showNotice(msg) { notice.textContent = msg; notice.classList.remove('d-none'); }
    function hideNotice() { notice.classList.add('d-none'); }
 
    function goTo(n) {
      hideNotice();
      panels.forEach(p => p.classList.toggle('d-none', Number(p.dataset.panel) !== n));
      stepEls.forEach((el, i) => {
        const idx = i + 1;
        el.classList.toggle('active', idx === n);
        el.classList.toggle('done', idx < n);
        el.textContent = idx < n ? '✓' : idx;
        idx === n ? el.setAttribute('aria-current', 'step') : el.removeAttribute('aria-current');
      });
      stepper.setAttribute('aria-label', `Paso ${n} de 3`);
      panels[n - 1].querySelector('h1').focus();
    }
 
    /* ===================== Paso 1: enviar correo ===================== */
    const formEmail = document.getElementById('form-email');
    const email     = document.getElementById('email');
    const btnSend   = document.getElementById('btn-send');
    let sentTo = '';
 
    formEmail.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideNotice();
      const value = email.value.trim();
      const valid = value !== '' && email.checkValidity();
      email.classList.toggle('is-invalid', !valid);
      if (!valid) { email.focus(); return; }
 
      btnSend.disabled = true;
      btnSend.textContent = 'Enviando…';
      try {
        await api.forgotPassword(value);
        sentTo = value;
        document.getElementById('email-sent').textContent = value;
        goTo(2);
        startCountdown();
      } catch (err) {
        showNotice(err.message);
      } finally {
        btnSend.disabled = false;
        btnSend.textContent = 'Enviar enlace';
      }
    });
    email.addEventListener('input', () => email.classList.remove('is-invalid'));
 
    /* ===================== Paso 2: reenviar con cuenta regresiva ===================== */
    const btnResend = document.getElementById('btn-resend');
    const countdown = document.getElementById('countdown');
    let timerId;
 
    function startCountdown(seconds = 45) {
      clearInterval(timerId);
      let left = seconds;
      btnResend.disabled = true;
      const render = () => countdown.textContent = `Podrás reenviarlo en 00:${String(left).padStart(2, '0')}`;
      render();
      timerId = setInterval(() => {
        left--;
        if (left <= 0) {
          clearInterval(timerId);
          btnResend.disabled = false;
          countdown.textContent = '¿No te llegó? Ya puedes reenviarlo.';
        } else {
          render();
        }
      }, 1000);
    }
 
    btnResend.addEventListener('click', async () => {
      hideNotice();
      btnResend.disabled = true;
      try {
        await api.forgotPassword(sentTo);
        showNotice('Te enviamos un nuevo enlace.');
        startCountdown();
      } catch (err) {
        showNotice(err.message);
        btnResend.disabled = false;
      }
    });
 
    /* ===================== Paso 3: nueva contraseña ===================== */
    const formPass  = document.getElementById('form-password');
    const pass      = document.getElementById('password');
    const pass2     = document.getElementById('password2');
    const bar       = document.getElementById('strength-bar');
    const barWrap   = bar.parentElement;
    const barLabel  = document.getElementById('strength-label');
    const btnSave   = document.getElementById('btn-save');
 
    function checkRules(v) {
      return { length: v.length >= 8, upper: /[A-Z]/.test(v), number: /\d/.test(v) };
    }
 
    function updateStrength() {
      const v = pass.value;
      const met = Object.values(checkRules(v)).filter(Boolean).length;
      let pct = 0, color = 'var(--cp-red)', text = '';
      if (v) {
        if (met <= 1)      { pct = 33;  color = 'var(--cp-red)';   text = 'Débil'; }
        else if (met === 2){ pct = 66;  color = 'var(--cp-amber)'; text = 'Media'; }
        else               { pct = 100; color = 'var(--cp-green)'; text = 'Segura'; }
      }
      bar.style.width = pct + '%';
      bar.style.backgroundColor = color;
      barWrap.setAttribute('aria-valuenow', pct);
      barLabel.textContent = text;
      barLabel.style.color = color;
    }
 
    pass.addEventListener('input', () => { updateStrength(); pass.classList.remove('is-invalid'); });
    pass2.addEventListener('input', () => pass2.classList.remove('is-invalid'));
 
    formPass.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideNotice();
 
      const rules = checkRules(pass.value);
      const okRules = rules.length && rules.upper && rules.number;
      const okMatch = pass.value === pass2.value && pass2.value !== '';
      pass.classList.toggle('is-invalid', !okRules);
      pass2.classList.toggle('is-invalid', !okMatch);
      if (!okRules) { pass.focus(); return; }
      if (!okMatch) { pass2.focus(); return; }
 
      const token = new URLSearchParams(location.search).get('token');
      btnSave.disabled = true;
      btnSave.textContent = 'Guardando…';
      try {
        await api.resetPassword(token, pass.value);
        formPass.classList.add('d-none');
        showNotice('Contraseña actualizada. Ya puedes iniciar sesión.');
        // window.location.href = '/iniciar-sesion';
      } catch (err) {
        showNotice(err.message);
        btnSave.disabled = false;
        btnSave.textContent = 'Guardar contraseña';
      }
    });
 
    /* ===================== Arranque ===================== */
    // El enlace del correo apunta a /recuperar-acceso?token=XXXX → entra directo al paso 3.
    // Para probar en local sin backend, abre este archivo con ?token=demo
    if (new URLSearchParams(location.search).get('token')) goTo(3);
  </script>
</body>
</html>
 