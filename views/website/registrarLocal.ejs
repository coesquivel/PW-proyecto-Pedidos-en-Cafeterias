<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registrar mi local | Campus Pide</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Tipografía del sistema de diseño -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Estilos compartidos del Navbar -->
  <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
  <link rel="stylesheet" href="/assets/css/Login/_footerL.css">
  <link rel="stylesheet" href="/assets/css/RegistrarLocal/_registrarLocal.css">

  <style>

  </style>
</head>

<body>
  <!-- NAVBAR COMPARTIDO (igual que home) -->
  <%- include('partials/Home/_navbar') %>

  <main class="page">
    <nav class="breadcrumb-reg" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <strong>Registrar mi local</strong>
    </nav>

    <section class="registration-card">
      <form id="registerLocalForm" action="/registrar-local" method="POST" enctype="multipart/form-data">
        <div class="form-layout">
          <div class="form-main">
            <h1 class="form-heading">Registra tu local</h1>
            <p class="form-description">
              Validaremos tus datos antes de publicar tu carta en el directorio del campus.
            </p>

            <div class="fields-grid">
              <div class="field">
                <label for="nombreComercial">Nombre comercial</label>
                <input id="nombreComercial" name="nombreComercial" type="text"
                       placeholder="Nombre de tu local" value="" required>
              </div>

              <div class="field">
                <label for="ruc">RUC</label>
                <input id="ruc" name="ruc" type="text" inputmode="numeric"
                       pattern="[0-9]{11}" maxlength="11" placeholder="Ingresa tu RUC"
                       value="" required>
              </div>

              <div class="field">
                <label for="sede">Sede</label>
                <select id="sede" name="sede" required>
                  <option value="Monterrico">Monterrico</option>
                  <option value="Villa">Villa</option>
                  <option value="Otro">Otra sede</option>
                </select>
              </div>

              <div class="field">
                <label for="ubicacion">Ubicación en el campus</label>
                <input id="ubicacion" name="ubicacion" type="text"
                       placeholder="Ej. Pabellón E, primer piso"
                       value="" required>
              </div>

              <div class="field">
                <label for="correo">Correo de contacto</label>
                <input id="correo" name="correo" type="email"
                       placeholder="correo@ejemplo.com"
                       value="" required>
              </div>

              <div class="field">
                <label for="telefono">Teléfono</label>
                <input id="telefono" name="telefono" type="tel"
                       placeholder="Ej. 912 345 678" value="" required>
              </div>

              <div class="field">
                <label for="contrasena">Contraseña</label>
                <input id="contrasena" name="contrasena" type="password"
                       placeholder="Crea una contraseña" value="" minlength="8" required>
              </div>

              <div class="field">
                <label for="confirmarContrasena">Confirmar contraseña</label>
                <input id="confirmarContrasena" name="confirmarContrasena" type="password"
                       placeholder="Repite la contraseña" value="" minlength="8" required>
              </div>
            </div>

            <label class="consent" for="autorizacion">
              <input id="autorizacion" name="autorizacion" type="checkbox" required>
              <span>Declaro que cuento con la autorización de la Universidad para operar este concesionario.</span>
            </label>
          </div>

          <aside class="logo-section">
            <label class="logo-title" for="logo">Logotipo del local</label>
            <div class="logo-preview" id="logoPreview">
              <span id="logoPlaceholder">logotipo 1:1</span>
              <img id="logoImage" src="" alt="Vista previa del logotipo del local">
            </div>

            <input class="upload-input" id="logo" name="logo" type="file"
                   accept="image/png,image/jpeg,image/webp">
            <button class="upload-button" type="button" id="uploadButton">Subir imagen</button>

            <div class="info-note">
              Tras el registro un administrador revisa el RUC y la ubicación declarada.
              Recibirás un correo cuando tu local quede habilitado para publicar su carta y recibir pedidos.
            </div>
          </aside>
        </div>

        <!-- MENSAJE DE ERROR O ÉXITO -->
        <p class="error-message" id="formError" role="alert"></p>

        <div class="form-actions">
          <button class="btn-reg btn-reg-secondary" type="reset">Cancelar</button>
          <button class="btn-reg btn-reg-primary" type="submit">Enviar solicitud</button>
        </div>
      </form>
    </section>
  </main>

    <!-- FOOTER -->
    <%- include('partials/Login/_footer') %>


  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const logoInput = document.getElementById('logo');
    const uploadButton = document.getElementById('uploadButton');
    const logoImage = document.getElementById('logoImage');
    const logoPlaceholder = document.getElementById('logoPlaceholder');
    const form = document.getElementById('registerLocalForm');
    const formError = document.getElementById('formError');

    uploadButton.addEventListener('click', () => logoInput.click());

    logoInput.addEventListener('change', () => {
      const file = logoInput.files && logoInput.files[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        logoInput.value = '';
        formError.textContent = 'Selecciona un archivo de imagen válido.';
        formError.style.color = '#dc3545';
        formError.style.display = 'block';
        return;
      }

      const reader = new FileReader();
      reader.onload = (event) => {
        logoImage.src = event.target.result;
        logoImage.style.display = 'block';
        logoPlaceholder.style.display = 'none';
        formError.style.display = 'none';
      };
      reader.readAsDataURL(file);
    });

    // Función auxiliar para resetear la imagen y vista previa
    function resetLogoPreview() {
      logoImage.src = '';
      logoImage.style.display = 'none';
      logoPlaceholder.style.display = 'block';
      logoInput.value = '';
    }

    form.addEventListener('reset', () => {
      window.setTimeout(() => {
        resetLogoPreview();
        formError.style.display = 'none';
      }, 0);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault(); // Detiene el envio por defecto para procesar validaciones

      const password = document.getElementById('contrasena').value;
      const confirmPassword = document.getElementById('confirmarContrasena').value;

      // 1. Validar coincidencia de contraseñas
      if (password !== confirmPassword) {
        formError.textContent = 'Las contraseñas no coinciden. Verifica ambos campos.';
        formError.style.color = '#dc3545';
        formError.style.display = 'block';
        document.getElementById('confirmarContrasena').focus();
        return;
      }

      // 2. Validar tamaño del logo si se adjuntó alguno
      if (logoInput.files.length > 0 && logoInput.files[0].size > 5 * 1024 * 1024) {
        formError.textContent = 'El logotipo debe pesar menos de 5 MB.';
        formError.style.color = '#dc3545';
        formError.style.display = 'block';
        return;
      }

      // 3. SI TODOS LOS CAMPOS ESTÁN CORRECTOS:
      // Limpia todos los inputs e inputs de tipo checkbox/select
      form.reset();
      resetLogoPreview();

      // Muestra un mensaje de confirmación exitosa
      formError.textContent = '¡Solicitud enviada con éxito! Revisaremos tus datos a la brevedad.';
      formError.style.color = '#198754'; // Color verde de éxito
      formError.style.display = 'block';
    });
  </script>
</body>
</html>