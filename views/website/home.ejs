<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Pide</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">
</head>

<body>

    <!-- NAVBAR -->
    <%- include('partials/Home/_navbar') %>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <h1>Pide antes, recoge sin hacer cola</h1>

                    <p>
                        Elige un local del campus, arma tu pedido con sus opciones
                        y escoge la hora de recojo. Pagas en el mostrador al recibirlo.
                    </p>

                    <form class="search-box">
                        <input
                            type="text"
                            placeholder="Busca «sandwich» o «Cafetería Central»"
                        >
                        <button type="submit">Buscar</button>
                    </form>

                    <div class="hero-stats">
                        <span>5 locales en el campus</span>
                        <span>18 productos publicados</span>
                        <span>Recojo desde las 07:00</span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="hero-image-container">
                        <img
                            src="assets/img/cafeteria.png"
                            alt="Cafeteria"
                            class="img-fluid"
                        >
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container main-content">

        <!-- LOCALES -->
        <section>
            <div class="section-title">
                <h2>Locales del campus</h2>
                <a href="#">Ver todos los locales →</a>
            </div>

            <div class="row g-3">

                <!-- Local 1 -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="local-card">

                        <div class="local-image">
                            <img
                                src="assets/img/cafeteriaCentral.png"
                                alt="Cafeteria Central"
                                class="img-fluid"
                            >
                        </div>

                        <div class="local-info">
                            <div class="local-name">
                                <span>Cafetería Central</span>
                                <span class="badge-open">Abierto</span>
                            </div>

                            <div class="local-description">
                                Pabellón A · 07:00 a 19:00 · 12 min
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Local 2 -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="local-card">

                        <div class="local-image">
                            <img
                                src="assets/img/sangucheria.png"
                                alt="Sangucheria"
                                class="img-fluid"
                            >
                        </div>

                        <div class="local-info">
                            <div class="local-name">
                                <span>Sanguchería Pabellón E</span>
                                <span class="badge-open">Abierto</span>
                            </div>

                            <div class="local-description">
                                Pabellón E · 08:00 a 18:00 · 10 min
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Local 3 -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="local-card">

                        <div class="local-image">
                            <img
                                src="assets/img/cafeBiblioteca.png"
                                alt="Cafe Biblioteca"
                                class="img-fluid"
                            >
                        </div>

                        <div class="local-info">
                            <div class="local-name">
                                <span>Café de Biblioteca</span>
                                <span class="badge-open">Abierto</span>
                            </div>

                            <div class="local-description">
                                Biblioteca, piso 1 · 08:00 a 20:00 · 6 min
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Local 4 -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="local-card">

                        <div class="local-image">
                            <img
                                src="assets/img/jugueria.png"
                                alt="Jugueria"
                                class="img-fluid"
                            >
                        </div>

                        <div class="local-info">
                            <div class="local-name">
                                <span>Juguería La Fuente</span>
                                <span class="badge-closed">Cerrado</span>
                            </div>

                            <div class="local-description">
                                Patio central · abre 09:00 · 8 min
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- PASOS -->
        <section class="steps">
            <div class="row g-3">

                <!-- Paso 1 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">1</div>

                        <div class="step-title">
                            Elige tu local
                        </div>

                        <div class="step-description">
                            Revisa la carta, elige el precio y el tiempo de preparación.
                        </div>

                    </div>
                </div>

                <!-- Paso 2 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">2</div>

                        <div class="step-title">
                            Arma tu pedido
                        </div>

                        <div class="step-description">
                            Agrega productos con sus opciones, agregados y notas.
                        </div>

                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">3</div>

                        <div class="step-title">
                            Recoge con tu código
                        </div>

                        <div class="step-description">
                            Dicta tu código en el mostrador y paga ahí mismo.
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- CTA -->
        <section class="cta">

            <div>
                <div class="cta-title">
                    ¿Atiendes un local en el campus?
                </div>

                <div class="cta-text">
                    Publica tu carta y recibe pedidos anticipados con hora de recojo.
                </div>
            </div>

            <a href="#" class="btn cta-button">
                Registrar mi local
            </a>

        </section>

    </main>

    <!-- FOOTER -->
    <%- include('partials/Home/_footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>