<!-- views\website\home.ejs -->
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Pide</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">
</head>

<body class="home-page">

    <!-- NAVBAR -->
    <%- include('partials/Home/_navbar') %>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <h1>Pide antes, recoge sin hacer cola</h1>

                    <p>
                        Elige un local del campus, arma tu pedido con sus opciones
                        y escoge la hora de recojo. Pagas en el mostrador al recibirlo.
                    </p>

                    <!-- FORMULARIO DE BÚSQUEDA REDIRIGIBLE -->
                    <form class="search-box" id="formBuscadorHome">
                        <input
                            type="text"
                            id="inputBuscadorHome"
                            placeholder="Busca «sandwich» o «Cafetería Central»"
                            required
                        >
                        <button type="submit">Buscar</button>
                    </form>

                    <div class="hero-stats">
                        <span><%= totalLocales %> locales en el campus</span>
                        <span>Pagas en el mostrador al recibirlo</span>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="hero-image-container">
                        <img
                            src="/assets/img/cafeteria-web.jpg"
                            alt="Cafeteria"
                            class="img-fluid"
                        >
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container main-content">

        <!-- LOCALES -->
        <section>
            <div class="section-title">
                <h2>Locales del campus</h2>
                <a href="/locales">Ver todos los locales →</a>
            </div>

            <% if (locales.length === 0) { %>
                <p class="text-muted">Aún no hay locales disponibles en el campus.</p>
            <% } %>

            <div class="row g-3">
                <% locales.forEach(function (l) { %>
                <div class="col-12 col-sm-6 col-lg-3">
                    <a href="/locales/<%= l.id %>" class="local-card-link">
                        <div class="local-card">
                            <div class="local-image">
                                <img src="<%= l.imagen %>" alt="<%= l.nombre %>" class="img-fluid">
                            </div>
                            <div class="local-info">
                                <div class="local-name">
                                    <span><%= l.nombre %></span>
                                    <span class="<%= l.abierto ? 'badge-open' : 'badge-closed' %>"><%= l.abierto ? 'Abierto' : 'Cerrado' %></span>
                                </div>
                                <div class="local-description">
                                    <%= l.ubicacion %> · <%= l.horario %>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <% }); %>
            </div>
        </section>
 
        <!-- PASOS -->
        <section class="steps">
            <div class="row g-3">

                <!-- Paso 1 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">1</div>

                        <div class="step-title">
                            Elige tu local
                        </div>

                        <div class="step-description">
                            Revisa la carta, elige el precio y el tiempo de preparación.
                        </div>

                    </div>
                </div>

                <!-- Paso 2 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">2</div>

                        <div class="step-title">
                            Arma tu pedido
                        </div>

                        <div class="step-description">
                            Agrega productos con sus opciones, agregados y notas.
                        </div>

                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="col-12 col-md-4">
                    <div class="step-card">

                        <div class="step-number">3</div>

                        <div class="step-title">
                            Recoge con tu código
                        </div>

                        <div class="step-description">
                            Dicta tu código en el mostrador y paga ahí mismo.
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- CTA -->
        <section class="cta">

            <div>
                <div class="cta-title">
                    ¿Atiendes un local en el campus?
                </div>

                <div class="cta-text">
                    Publica tu carta y recibe pedidos anticipados con hora de recojo.
                </div>
            </div>

            <a href="/registrarLocal" class="btn cta-button">
                Registrar mi local
            </a>

        </section>

    </main>

    <!-- FOOTER -->
    <%- include('partials/Home/_footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- BÚSQUEDA: lleva a la lista de locales filtrada -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('formBuscadorHome');
            const input = document.getElementById('inputBuscadorHome');

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const busqueda = input.value.trim();
                if (!busqueda) return;
                window.location.href = `/locales?q=${encodeURIComponent(busqueda)}`;
            });
        });
    </script>

</body>
</html>