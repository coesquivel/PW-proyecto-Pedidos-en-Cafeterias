<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Pide | Locales del Campus</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">
    <link rel="stylesheet" href="/assets/css/Home/_locales.css">
</head>

<body>

    <!-- NAVBAR -->
    <%- include('partials/Home/_navbar') %>

    <!-- ENCABEZADO DE LOCALES (Mismo estilo Hero) -->
    <section class="locales-header">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Locales</li>
                </ol>
            </nav>

            <div class="row align-items-end g-3">
                <div class="col-lg-6">
                    <h1>Locales del campus</h1>
                    <p class="mb-0">
                        Selecciona tu cafetería o sanguchería favorita, revisa su carta actualizada y programa tu hora de recojo.
                    </p>
                </div>

                <div class="col-lg-6">
                    <form class="search-box ms-lg-auto" id="formBuscarLocal" onsubmit="return false;">
                        <input
                            type="text"
                            id="inputBuscarLocal"
                            placeholder="Buscar por nombre o ubicación (ej. «Pabellón E», «Biblioteca»)..."
                        >
                        <button type="submit">Buscar</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="container main-content py-4">

        <!-- BARRA DE FILTROS -->
        <div class="filters-bar mb-4">
            <div class="filter-pills" id="filterPills">
                <button class="filter-btn active" data-filter="todos">Todos los locales</button>
                <button class="filter-btn" data-filter="abierto">Abiertos ahora</button>
                <button class="filter-btn" data-filter="cafeteria">Cafeterías y Menú</button>
                <button class="filter-btn" data-filter="sangucheria">Sangucherías y Jugos</button>
            </div>

            <div class="locales-count">
                Mostrando <strong id="contadorLocales">5</strong> locales disponibles
            </div>
        </div>

        <!-- DATOS POR DEFECTO SI AÚN NO VIENEN DEL BACKEND -->
        <%
            const listaLocales = (typeof locales !== 'undefined' && locales.length > 0) ? locales : [
                {
                    id: 1,
                    nombre: 'Cafetería Central',
                    imagen: '/assets/img/cafeteriaCentral.png',
                    abierto: true,
                    ubicacion: 'Pabellón A',
                    horario: '07:00 a 19:00',
                    tiempo: '12 min',
                    categoria: 'cafeteria',
                    especialidad: 'Desayunos, almuerzos ejecutivos y café pasado',
                    productosCount: 6
                },
                {
                    id: 2,
                    nombre: 'Sanguchería Pabellón E',
                    imagen: '/assets/img/sangucheria.png',
                    abierto: true,
                    ubicacion: 'Pabellón E',
                    horario: '08:00 a 18:00',
                    tiempo: '10 min',
                    categoria: 'sangucheria',
                    especialidad: 'Sánguches artesanales, triples, empanadas y bebidas',
                    productosCount: 5
                },
                {
                    id: 3,
                    nombre: 'Café de Biblioteca',
                    imagen: '/assets/img/cafeBiblioteca.png',
                    abierto: true,
                    ubicacion: 'Biblioteca, piso 1',
                    horario: '08:00 a 20:00',
                    tiempo: '6 min',
                    categoria: 'cafeteria',
                    especialidad: 'Espresso, postres, croissants y snacks rápidos',
                    productosCount: 4
                },
                {
                    id: 4,
                    nombre: 'Juguería La Fuente',
                    imagen: '/assets/img/jugueria.png',
                    abierto: false,
                    ubicacion: 'Patio central',
                    horario: 'abre 09:00',
                    tiempo: '8 min',
                    categoria: 'sangucheria',
                    especialidad: 'Jugos naturales, batidos proteicos y ensaladas de frutas',
                    productosCount: 3
                },
                {
                    id: 5,
                    nombre: 'Kiosco Pabellón C',
                    imagen: '/assets/img/cafeteria.png',
                    abierto: true,
                    ubicacion: 'Pabellón C, piso 1',
                    horario: '07:30 a 17:30',
                    tiempo: '5 min',
                    categoria: 'sangucheria',
                    especialidad: 'Wraps, choclos con queso, bebidas frías y snacks',
                    productosCount: 4
                }
            ];
        %>

        <!-- GRILLA DE LOCALES -->
        <div class="row g-4" id="gridLocales">
            <% listaLocales.forEach(local => { %>
                <div class="col-12 col-sm-6 col-lg-4 local-item" 
                     data-nombre="<%= local.nombre.toLowerCase() %> <%= local.ubicacion.toLowerCase() %> <%= local.especialidad.toLowerCase() %>"
                     data-estado="<%= local.abierto ? 'abierto' : 'cerrado' %>"
                     data-categoria="<%= local.categoria %>">
                    
                    <a href="/locales/<%= local.id %>" class="local-card-link">
                        <div class="local-card h-100">

                            <div class="local-image position-relative">
                                <img
                                    src="<%= local.imagen %>"
                                    alt="<%= local.nombre %>"
                                    class="img-fluid"
                                >
                                <span class="time-pill">⏱ <%= local.tiempo %></span>
                            </div>

                            <div class="local-info d-flex flex-column justify-content-between">
                                <div>
                                    <div class="local-name">
                                        <span><%= local.nombre %></span>
                                        <% if (local.abierto) { %>
                                            <span class="badge-open">Abierto</span>
                                        <% } else { %>
                                            <span class="badge-closed">Cerrado</span>
                                        <% } %>
                                    </div>

                                    <div class="local-description mb-2">
                                        <%= local.ubicacion %> · <%= local.horario %> · <%= local.tiempo %>
                                    </div>

                                    <p class="local-specialty mb-3">
                                        <%= local.especialidad %>
                                    </p>
                                </div>

                                <div class="local-card-footer">
                                    <span class="products-count"><%= local.productosCount %> productos en carta</span>
                                    <span class="action-link">Ver carta →</span>
                                </div>
                            </div>

                        </div>
                    </a>

                </div>
            <% }) %>
        </div>

        <!-- MENSAJE SI NO HAY RESULTADOS EN BÚSQUEDA -->
        <div id="sinResultados" class="empty-state text-center d-none">
            <h4>No encontramos locales con ese criterio</h4>
            <p>Prueba buscando otro pabellón o mostrando todos los locales.</p>
            <button class="btn cta-button" id="btnResetFiltros">Ver todos los locales</button>
        </div>

    </main>

    <!-- FOOTER -->
    <%- include('partials/Home/_footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script para filtrar y buscar en tiempo real -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputBuscar = document.getElementById('inputBuscarLocal');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const items = document.querySelectorAll('.local-item');
            const contador = document.getElementById('contadorLocales');
            const sinResultados = document.getElementById('sinResultados');
            const btnReset = document.getElementById('btnResetFiltros');

            let filtroActual = 'todos';

            function filtrarLocales() {
                const texto = inputBuscar.value.toLowerCase().trim();
                let visibles = 0;

                items.forEach(item => {
                    const nombre = item.dataset.nombre;
                    const estado = item.dataset.estado;
                    const categoria = item.dataset.categoria;

                    const coincideTexto = nombre.includes(texto);
                    let coincideFiltro = true;

                    if (filtroActual === 'abierto') {
                        coincideFiltro = (estado === 'abierto');
                    } else if (filtroActual !== 'todos') {
                        coincideFiltro = (categoria === filtroActual);
                    }

                    if (coincideTexto && coincideFiltro) {
                        item.classList.remove('d-none');
                        visibles++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                contador.textContent = visibles;
                sinResultados.classList.toggle('d-none', visibles > 0);
            }

            inputBuscar.addEventListener('input', filtrarLocales);

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    filtroActual = btn.dataset.filter;
                    filtrarLocales();
                });
            });

            btnReset.addEventListener('click', () => {
                inputBuscar.value = '';
                filterBtns[0].click();
            });
        });
    </script>
</body>
</html>