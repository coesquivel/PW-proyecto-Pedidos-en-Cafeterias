<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Campus Pide | Carta del Local</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tus mismos CSS del Home -->
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">

    <style>
        body {
            background-color: #fcfaf9;
            color: #222;
        }

        /* Cabecera del restaurante */
        .hero.hero-detalle {
            padding: 2rem 0;
            background-color: #fdf0ed;
            border-bottom: 1px solid #f2dcd6;
        }

        .breadcrumb-custom {
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .breadcrumb-custom a {
            color: #d93829;
            text-decoration: none;
            font-weight: 600;
        }

        .local-banner-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 14px;
            border: 1px solid #ece7e5;
        }

        .badge-open {
            background-color: #4ea845;
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
        }

        .badge-closed {
            background-color: #e9ecef;
            color: #6c757d;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
        }

        /* Tarjetas de productos */
        .product-card {
            background: #ffffff;
            border: 1px solid #ece7e5;
            border-radius: 12px;
            padding: 1.1rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        }

        .product-cat {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #d93829;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .product-title {
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: 0.35rem;
        }

        .product-desc {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 1rem;
        }

        .product-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 0.75rem;
            border-top: 1px solid #f4f1ef;
        }

        .product-price {
            font-weight: 800;
            font-size: 1.1rem;
            color: #222;
        }

        .btn-add {
            background-color: #fdf0ed;
            color: #d93829;
            border: 1px solid #f3cfc8;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.4rem 0.9rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-add:hover:not(:disabled) {
            background-color: #d93829;
            color: #ffffff;
            border-color: #d93829;
        }

        /* Panel lateral de pedido (Carrito) */
        .order-panel {
            background: #ffffff;
            border: 1px solid #ece7e5;
            border-radius: 14px;
            padding: 1.5rem;
            position: sticky;
            top: 1.5rem;
        }

        .order-panel h4 {
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #ece7e5;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 0.65rem 0;
            border-bottom: 1px dashed #ece7e5;
            font-size: 0.9rem;
        }

        .cart-item-title {
            font-weight: 600;
            color: #222;
        }

        .cart-item-notes {
            font-size: 0.78rem;
            color: #6c757d;
        }

        .btn-remove {
            color: #dc3545;
            background: none;
            border: none;
            font-size: 0.8rem;
            padding: 0;
            margin-left: 0.5rem;
        }

        .btn-confirm {
            background-color: #d93829;
            color: #ffffff;
            font-weight: 700;
            width: 100%;
            padding: 0.75rem;
            border-radius: 10px;
            border: none;
            transition: background 0.2s ease;
        }

        .btn-confirm:hover:not(:disabled) {
            background-color: #b82b1e;
            color: #ffffff;
        }

        .btn-confirm:disabled {
            background-color: #e2dcd9;
            color: #888;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <%- include('../partials/Home/_navbar') %>

    <%
        // Catálogo unificado de los 5 locales y sus productos
        const catalogoLocales = {
            1: {
                id: 1,
                nombre: 'Cafetería Central',
                imagen: '/assets/img/cafeteriaCentral.png',
                abierto: true,
                ubicacion: 'Pabellón A',
                horario: '07:00 a 19:00',
                tiempo: '12 min',
                descripcion: 'Desayunos, menú universitario, platos a la carta y café pasado.',
                productos: [
                    { id: 101, categoria: 'Menú del día', nombre: 'Menú Universitario', desc: 'Entrada + Segundo del día + Refresco natural.', precio: 12.50, opciones: ['Entrada: Ensalada fresca', 'Entrada: Sopa criolla', 'Entrada: Tequeños'] },
                    { id: 102, categoria: 'Platos a la carta', nombre: 'Lomo Saltado Clásico', desc: 'Con papas fritas crujientes y arroz blanco.', precio: 16.00, opciones: ['Término bien cocido', 'Término tres cuartos', 'Sin cebolla'] },
                    { id: 103, categoria: 'Sánguches', nombre: 'Pan con Pollo Deshilachado', desc: 'Pollo, apio, mayonesa de la casa y papas al hilo.', precio: 7.50, opciones: ['Con mayonesa y ají', 'Solo mayonesa', 'Sin cremas'] },
                    { id: 104, categoria: 'Bebidas', nombre: 'Café Pasado Grande', desc: 'Café orgánico recién pasado (12 oz).', precio: 4.50, opciones: ['Con azúcar', 'Con edulcorante', 'Sin endulzar'] }
                ]
            },
            2: {
                id: 2,
                nombre: 'Sanguchería Pabellón E',
                imagen: '/assets/img/sangucheria.png',
                abierto: true,
                ubicacion: 'Pabellón E',
                horario: '08:00 a 18:00',
                tiempo: '10 min',
                descripcion: 'Especialistas en sánguches calientes, triples y empanadas.',
                productos: [
                    { id: 201, categoria: 'Sánguches', nombre: 'Butifarra Criolla', desc: 'Jamón del país artesanal con zarza criolla en pan francés.', precio: 8.50, opciones: ['Con ají de la casa', 'Sin picante'] },
                    { id: 202, categoria: 'Sánguches', nombre: 'Triple Clásico', desc: 'Palta, tomate, huevo y mayonesa en pan de molde.', precio: 7.00, opciones: ['Pan blanco', 'Pan integral'] },
                    { id: 203, categoria: 'Horneados', nombre: 'Empanada de Carne', desc: 'Rellena de lomo picado, aceituna y huevo duro.', precio: 5.50, opciones: ['Caliente con limón', 'Temperatura ambiente'] },
                    { id: 204, categoria: 'Bebidas', nombre: 'Chicha Morada 500ml', desc: 'Hecha con maíz morado natural, piña y canela.', precio: 4.00, opciones: ['Helada', 'Sin hielo'] }
                ]
            },
            3: {
                id: 3,
                nombre: 'Café de Biblioteca',
                imagen: '/assets/img/cafeBiblioteca.png',
                abierto: true,
                ubicacion: 'Biblioteca, piso 1',
                horario: '08:00 a 20:00',
                tiempo: '6 min',
                descripcion: 'Cafés de especialidad, postres y snacks rápidos para tus sesiones de estudio.',
                productos: [
                    { id: 301, categoria: 'Cafetería', nombre: 'Cappuccino Italiano', desc: 'Espresso doble con leche texturizada (10 oz).', precio: 6.50, opciones: ['Leche entera', 'Leche sin lactosa', 'Leche de almendras (+S/1)'] },
                    { id: 302, categoria: 'Snacks', nombre: 'Croissant Mixto', desc: 'Croissant de mantequilla relleno de jamón inglés y queso edam.', precio: 7.50, opciones: ['Planchado caliente', 'Sin calentar'] },
                    { id: 303, categoria: 'Postres', nombre: 'Muffin de Arándanos', desc: 'Queque esponjoso con arándanos frescos.', precio: 5.00, opciones: ['Para llevar', 'Para comer aquí'] }
                ]
            },
            4: {
                id: 4,
                nombre: 'Juguería La Fuente',
                imagen: '/assets/img/jugueria.png',
                abierto: false,
                ubicacion: 'Patio central',
                horario: 'abre 09:00',
                tiempo: '8 min',
                descripcion: 'Jugos naturales al instante, batidos y ensaladas de frutas.',
                productos: [
                    { id: 401, categoria: 'Jugos', nombre: 'Jugo Surtido Clásico', desc: 'Papaya, piña, plátano y beterraga (16 oz).', precio: 6.00, opciones: ['Bajo en azúcar', 'Sin azúcar', 'Con miel'] },
                    { id: 402, categoria: 'Batidos', nombre: 'Batido de Fresa con Leche', desc: 'Fresas frescas seleccionadas con leche evaporada o fresca.', precio: 7.50, opciones: ['Leche entera', 'Leche deslactosada'] },
                    { id: 403, categoria: 'Bowls', nombre: 'Ensalada de Frutas', desc: 'Frutas de estación con yogurt griego, miel y granola.', precio: 9.00, opciones: ['Yogurt natural', 'Yogurt de vainilla'] }
                ]
            },
            5: {
                id: 5,
                nombre: 'Cafetería Pabellón C',
                imagen: '/assets/img/cafeteria.png',
                abierto: true,
                ubicacion: 'Pabellón C, piso 1',
                horario: '07:30 a 18:30',
                tiempo: '8 min',
                descripcion: 'Wraps, ensaladas frescas, chapatas y bebidas frías.',
                productos: [
                    { id: 501, categoria: 'Wraps', nombre: 'Wrap César con Pollo', desc: 'Tortilla de trigo con pollo grillado, lechuga, parmesano y aliño césar.', precio: 10.50, opciones: ['Con aliño aparte', 'Aliño mezclado'] },
                    { id: 502, categoria: 'Ensaladas', nombre: 'Bowl Proteico', desc: 'Quinua, pollo, palta, choclo, tomate cherry y huevo.', precio: 13.00, opciones: ['Vinagreta de la casa', 'Limón y aceite de oliva'] }
                ]
            }
        };

        const idActual = (typeof localId !== 'undefined' && catalogoLocales[localId]) ? localId : 1;
        const local = (typeof localData !== 'undefined') ? localData : catalogoLocales[idActual];
    %>

    <!-- CABECERA DEL LOCAL -->
    <section class="hero hero-detalle">
        <div class="container">
            <div class="breadcrumb-custom">
                <a href="/locales">← Volver a todos los locales</a> <span>/ <%= local.nombre %></span>
            </div>

            <div class="row align-items-center g-4">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <h1 class="mb-0"><%= local.nombre %></h1>
                        <% if (local.abierto) { %>
                            <span class="badge-open">Abierto</span>
                        <% } else { %>
                            <span class="badge-closed">Cerrado</span>
                        <% } %>
                    </div>
                    <p class="mb-2"><%= local.descripcion %></p>
                    <div class="hero-stats mt-2">
                        <span>📍 <%= local.ubicacion %></span>
                        <span>🕒 <%= local.horario %></span>
                        <span>⏱ Prep. aprox: <%= local.tiempo %></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <img src="<%= local.imagen %>" alt="<%= local.nombre %>" class="local-banner-img">
                </div>
            </div>
        </div>
    </section>

    <!-- CARTA Y PEDIDO -->
    <main class="container my-4">
        <div class="row g-4">

            <!-- COLUMNA IZQUIERDA: CARTA DE PRODUCTOS -->
            <div class="col-lg-8">
                <h3 class="fw-bold mb-3" style="font-size: 1.35rem;">Carta disponible</h3>

                <% if (!local.abierto) { %>
                    <div class="alert alert-warning border-0 rounded-3">
                        Este local se encuentra cerrado en este momento (<%= local.horario %>). Puedes revisar su carta, pero los pedidos están deshabilitados.
                    </div>
                <% } %>

                <div class="row g-3">
                    <% local.productos.forEach(prod => { %>
                        <div class="col-12 col-md-6">
                            <div class="product-card">
                                <div>
                                    <div class="product-cat"><%= prod.categoria %></div>
                                    <div class="product-title"><%= prod.nombre %></div>
                                    <div class="product-desc"><%= prod.desc %></div>
                                </div>

                                <div class="product-footer">
                                    <span class="product-price">S/ <%= prod.precio.toFixed(2) %></span>
                                    <button 
                                        class="btn-add"
                                        <%= !local.abierto ? 'disabled' : '' %>
                                        onclick='abrirModalProducto(<%- JSON.stringify(prod) %>)'>
                                        + Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- COLUMNA DERECHA: TU PEDIDO Y HORA DE RECOJO -->
            <div class="col-lg-4">
                <div class="order-panel">
                    <h4>Tu pedido en <%= local.nombre %></h4>

                    <div id="listaCarrito" class="mb-3">
                        <p class="text-muted small mb-0" id="carritoVacioMsg">
                            Aún no has agregado productos a tu pedido.
                        </p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Hora de recojo en mostrador</label>
                        <select class="form-select form-select-sm" id="horaRecojo" <%= !local.abierto ? 'disabled' : '' %>>
                            <option value="En 15 min">Lo antes posible (<%= local.tiempo %>)</option>
                            <option value="10:30">10:30 AM</option>
                            <option value="11:00">11:00 AM</option>
                            <option value="12:30">12:30 PM</option>
                            <option value="13:00">01:00 PM</option>
                            <option value="13:30">01:30 PM</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between align-items-center fw-bold mb-3 pt-2 border-top">
                        <span>Total a pagar en mostrador:</span>
                        <span id="totalPedido" style="font-size: 1.2rem; color: #d93829;">S/ 0.00</span>
                    </div>

                    <button class="btn-confirm" id="btnConfirmarPedido" disabled onclick="generarCodigoPedido()">
                        Confirmar y generar código
                    </button>
                </div>
            </div>

        </div>
    </main>

    <!-- MODAL PARA OPCIONES Y NOTAS DEL PRODUCTO -->
    <div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="modalProdNombre">Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small" id="modalProdDesc"></p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Elige una opción:</label>
                        <select class="form-select" id="modalProdOpcion"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Notas adicionales (opcional):</label>
                        <input type="text" class="form-control" id="modalProdNota" placeholder="Ej. Sin picante, para llevar, etc.">
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn cta-button" id="btnGuardarEnCarrito">Agregar al pedido</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE CÓDIGO GENERADO (PASO 3) -->
    <div class="modal fade" id="modalCodigo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered text-center">
            <div class="modal-content rounded-4 border-0 p-3">
                <div class="modal-body">
                    <div class="mb-2" style="font-size: 2.5rem;">✅</div>
                    <h4 class="fw-bold">¡Pedido enviado al local!</h4>
                    <p class="text-muted small">Dicta este código en el mostrador de <strong><%= local.nombre %></strong> y paga al recoger:</p>
                    <div class="py-3 px-4 my-3 rounded-3 fw-bold" style="background: #fdf0ed; color: #d93829; font-size: 1.8rem; letter-spacing: 2px;" id="codigoGenerado">
                        CP-4821
                    </div>
                    <p class="small text-muted mb-3" id="resumenRecojo"></p>
                    <button type="button" class="btn cta-button w-100" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <%- include('../partials/Home/_footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let carrito = [];
        let productoActual = null;
        let modalInstancia = null;
        let modalCodigoInstancia = null;

        document.addEventListener('DOMContentLoaded', () => {
            modalInstancia = new bootstrap.Modal(document.getElementById('modalProducto'));
            modalCodigoInstancia = new bootstrap.Modal(document.getElementById('modalCodigo'));

            document.getElementById('btnGuardarEnCarrito').addEventListener('click', () => {
                if (!productoActual) return;
                const opcion = document.getElementById('modalProdOpcion').value;
                const nota = document.getElementById('modalProdNota').value.trim();

                carrito.push({
                    ...productoActual,
                    opcionElegida: opcion,
                    nota: nota
                });

                renderizarCarrito();
                modalInstancia.hide();
            });
        });

        function abrirModalProducto(prod) {
            productoActual = prod;
            document.getElementById('modalProdNombre').textContent = `${prod.nombre} (S/ ${prod.precio.toFixed(2)})`;
            document.getElementById('modalProdDesc').textContent = prod.desc;
            document.getElementById('modalProdNota').value = '';

            const selectOpcion = document.getElementById('modalProdOpcion');
            selectOpcion.innerHTML = '';
            prod.opciones.forEach(op => {
                const optionEl = document.createElement('option');
                optionEl.value = op;
                optionEl.textContent = op;
                selectOpcion.appendChild(optionEl);
            });

            modalInstancia.show();
        }

        function eliminarDelCarrito(index) {
            carrito.splice(index, 1);
            renderizarCarrito();
        }

        function renderizarCarrito() {
            const contenedor = document.getElementById('listaCarrito');
            const totalEl = document.getElementById('totalPedido');
            const btnConfirmar = document.getElementById('btnConfirmarPedido');

            if (carrito.length === 0) {
                contenedor.innerHTML = '<p class="text-muted small mb-0">Aún no has agregado productos a tu pedido.</p>';
                totalEl.textContent = 'S/ 0.00';
                btnConfirmar.disabled = true;
                return;
            }

            let html = '';
            let total = 0;

            carrito.forEach((item, idx) => {
                total += item.precio;
                html += `
                    <div class="cart-item">
                        <div>
                            <div class="cart-item-title">${item.nombre}</div>
                            <div class="cart-item-notes">${item.opcionElegida}${item.nota ? ' · ' + item.nota : ''}</div>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="fw-semibold">S/ ${item.precio.toFixed(2)}</span>
                            <button class="btn-remove" onclick="eliminarDelCarrito(${idx})">✕</button>
                        </div>
                    </div>
                `;
            });

            contenedor.innerHTML = html;
            totalEl.textContent = `S/ ${total.toFixed(2)}`;
            btnConfirmar.disabled = false;
        }

        function generarCodigoPedido() {
            const randomNum = Math.floor(1000 + Math.random() * 9000);
            const hora = document.getElementById('horaRecojo').value;
            document.getElementById('codigoGenerado').textContent = `CP-${randomNum}`;
            document.getElementById('resumenRecojo').textContent = `Hora programada de recojo: ${hora}`;
            carrito = [];
            renderizarCarrito();
            modalCodigoInstancia.show();
        }
    </script>
</body>
</html>