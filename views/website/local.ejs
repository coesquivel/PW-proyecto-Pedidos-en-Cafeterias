<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Pide | Información del Local</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/Home/_navbarH.css">
    <link rel="stylesheet" href="/assets/css/Home/_footerH.css">
    <link rel="stylesheet" href="/assets/css/Home/_home.css">

    <style>
        body {
            background-color: #fcfaf9;
            color: #252525;
        }

        .hero.hero-detalle {
            padding: 2.5rem 0;
            background: linear-gradient(120deg, #fdf0ed 0%, #fff9f6 100%);
            border-bottom: 1px solid #f2dcd6;
        }

        .breadcrumb-custom {
            font-size: .92rem;
            margin-bottom: 1.6rem;
            color: #69615e;
        }

        .breadcrumb-custom a {
            color: #d93829;
            text-decoration: none;
            font-weight: 650;
        }

        .breadcrumb-custom a:hover { text-decoration: underline; }

        .local-kicker {
            color: #d93829;
            font-size: .78rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .09em;
            margin-bottom: .6rem;
        }

        .local-main-title {
            font-weight: 800;
            letter-spacing: -.03em;
            line-height: 1.15;
            font-size: clamp(2rem, 4vw, 3rem);
        }

        .local-intro {
            color: #514b49;
            font-size: 1.08rem;
            line-height: 1.8;
            max-width: 680px;
        }

        .local-banner-img {
            display: block;
            width: 100%;
            height: 330px;
            object-fit: cover;
            border-radius: 16px;
            border: 1px solid #ece7e5;
            box-shadow: 0 10px 30px rgba(50, 25, 15, .08);
        }

        .badge-open, .badge-closed {
            display: inline-block;
            padding: .4rem .85rem;
            border-radius: 50px;
            font-size: .8rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .badge-open { background: #e4f4df; color: #34762c; }
        .badge-closed { background: #ece9e8; color: #6c6260; }

        .local-info-section { padding: 2.25rem 0 3.5rem; }

        .section-heading { margin-bottom: 1.25rem; }
        .section-heading .eyebrow {
            color: #d93829;
            font-weight: 750;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-size: .75rem;
            margin-bottom: .4rem;
        }
        .section-heading h2 {
            font-size: clamp(1.4rem, 2vw, 1.8rem);
            font-weight: 800;
            margin: 0;
        }
        .section-heading p {
            color: #6a6462;
            margin: .55rem 0 0;
            line-height: 1.65;
        }

        .info-card, .description-card {
            height: 100%;
            padding: 1.35rem;
            background: #fff;
            border: 1px solid #ece7e5;
            border-radius: 14px;
            box-shadow: 0 3px 12px rgba(40, 20, 10, .025);
        }

        .info-card .info-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #fdf0ed;
            font-size: 1.2rem;
            margin-bottom: .9rem;
        }

        .info-card h3 {
            color: #77706e;
            font-size: .85rem;
            font-weight: 700;
            margin-bottom: .45rem;
        }

        .info-card p {
            margin-bottom: 0;
            font-size: 1rem;
            font-weight: 650;
            line-height: 1.55;
        }

        .description-card h3 {
            margin-bottom: .75rem;
            font-size: 1.1rem;
            font-weight: 800;
        }

        .description-card p {
            margin-bottom: 0;
            color: #5c5654;
            line-height: 1.8;
        }


        .status-note {
            font-size: .86rem;
            color: #77706e;
            line-height: 1.6;
            margin-top: .7rem;
        }

        .info-footer-note {
            border-left: 3px solid #d93829;
            padding: .9rem 1rem;
            background: #fff;
            color: #625b58;
            border-radius: 0 10px 10px 0;
            font-size: .9rem;
            line-height: 1.65;
        }

        @media (max-width: 767.98px) {
            .hero.hero-detalle { padding: 1.5rem 0 2rem; }
            .local-banner-img { height: 240px; }
            .local-intro { font-size: 1rem; }
            .local-info-section { padding-top: 1.5rem; }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <%- include('../partials/Home/_navbar') %>

    <%
        // Información descriptiva de los locales. No incluye productos, precios ni pedidos.
        const catalogoLocales = {
            1: {
                id: 1,
                nombre: 'Cafetería Central',
                imagen: '/assets/img/cafeteriaCentral.png',
                abierto: true,
                ubicacion: 'Pabellón A',
                horario: '07:00 a 19:00',
                tiempo: '12 min',
                tipo: 'Cafetería universitaria',
                descripcion: 'Un punto de encuentro dentro del campus que reúne alternativas para empezar la mañana, hacer una pausa entre clases o almorzar durante la jornada universitaria.',
                descripcionLarga: 'La Cafetería Central ofrece una propuesta variada que combina desayunos, menú universitario, platos a la carta y café pasado. Por su variedad de opciones, es una alternativa para diferentes momentos del día, desde una parada breve por la mañana hasta una pausa más larga para almorzar.',
                caracteristica: 'Variedad para distintos momentos del día',
                ambiente: 'Un espacio práctico para hacer una pausa durante las actividades académicas.'
            },
            2: {
                id: 2,
                nombre: 'Sanguchería Pabellón E',
                imagen: '/assets/img/sangucheria.png',
                abierto: true,
                ubicacion: 'Pabellón E',
                horario: '08:00 a 18:00',
                tiempo: '10 min',
                tipo: 'Sanguchería y cafetería rápida',
                descripcion: 'Un local enfocado en alternativas prácticas para comer durante el día, con sánguches calientes, triples, empanadas y bebidas.',
                descripcionLarga: 'La Sanguchería Pabellón E se caracteriza por una propuesta centrada en sánguches y opciones de preparación rápida. Su variedad incluye sánguches calientes, triples y empanadas, acompañados de bebidas; una opción para quienes desean hacer una pausa entre clases o durante la jornada en el campus.',
                caracteristica: 'Opciones saladas y fáciles de disfrutar durante el día',
                ambiente: 'Un espacio informal pensado para una parada breve entre actividades.'
            },
            3: {
                id: 3,
                nombre: 'Café de Biblioteca',
                imagen: '/assets/img/cafeBiblioteca.png',
                abierto: true,
                ubicacion: 'Biblioteca, piso 1',
                horario: '08:00 a 20:00',
                tiempo: '6 min',
                tipo: 'Café y snacks',
                descripcion: 'Una alternativa cercana a la biblioteca para acompañar las jornadas de estudio con café, postres, croissants y snacks rápidos.',
                descripcionLarga: 'El Café de Biblioteca reúne bebidas a base de café y acompañamientos dulces o salados en una ubicación conveniente para quienes pasan tiempo estudiando. Su propuesta incluye espresso, postres, croissants y snacks rápidos, adecuados para una pausa breve durante el día académico.',
                caracteristica: 'Ubicación junto a la zona de estudio',
                ambiente: 'Una opción cercana para interrumpir brevemente la rutina de estudio y continuar con las actividades.'
            },
            4: {
                id: 4,
                nombre: 'Juguería La Fuente',
                imagen: '/assets/img/jugueria.png',
                abierto: false,
                ubicacion: 'Patio central',
                horario: 'Abre a las 09:00',
                tiempo: '8 min',
                tipo: 'Juguería',
                descripcion: 'Un local dedicado a bebidas frutales y alternativas frescas, con jugos naturales, batidos y ensaladas de frutas.',
                descripcionLarga: 'La Juguería La Fuente se enfoca en preparaciones a base de frutas. Su oferta descriptiva incluye jugos naturales, batidos proteicos y ensaladas de frutas, por lo que puede ser una alternativa para quienes prefieren una pausa fresca entre sus actividades en el campus.',
                caracteristica: 'Propuesta centrada en frutas y bebidas',
                ambiente: 'Una parada informal en el patio central para hacer una pausa y refrescarse.'
            },
            5: {
                id: 5,
                nombre: 'Cafetería Pabellón C',
                imagen: '/assets/img/cafeteria.png',
                abierto: true,
                ubicacion: 'Pabellón C, piso 1',
                horario: '07:30 a 18:30',
                tiempo: '8 min',
                tipo: 'Cafetería y snacks',
                descripcion: 'Una cafetería con alternativas saladas y bebidas para quienes necesitan una pausa rápida durante la jornada universitaria.',
                descripcionLarga: 'La Cafetería Pabellón C ofrece una selección de wraps, ensaladas frescas, chapatas y bebidas frías. Su propuesta combina opciones para quienes desean comer algo ligero con alternativas para acompañar una pausa entre clases o actividades dentro del campus.',
                caracteristica: 'Variedad de opciones ligeras y bebidas frías',
                ambiente: 'Una alternativa cómoda y cercana para hacer una pausa sin alejarse del pabellón.'
            }
        };

        const idActual = (typeof localId !== 'undefined' && catalogoLocales[localId])
            ? Number(localId)
            : 1;
        const localBase = catalogoLocales[idActual] || catalogoLocales[1];
        const datosRecibidos = (typeof localData !== 'undefined' && localData)
            ? localData
            : {};
        const local = { ...localBase, ...datosRecibidos };
        const estaAbierto = local.abierto === true || local.abierto === 'true' ||
            local.abierto === 1 || local.abierto === '1';
    %>

    <!-- CABECERA DEL RESTAURANTE -->
    <section class="hero hero-detalle">
        <div class="container">
            <div class="breadcrumb-custom">
                <a href="/locales">← Volver a todos los locales</a>
                <span> / <%= local.nombre %></span>
            </div>

            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="local-kicker"><%= local.tipo || localBase.tipo %></div>
                    <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                        <h1 class="local-main-title mb-0"><%= local.nombre %></h1>
                        <% if (estaAbierto) { %>
                            <span class="badge-open">Abierto</span>
                        <% } else { %>
                            <span class="badge-closed">Cerrado</span>
                        <% } %>
                    </div>
                    <p class="local-intro mb-3"><%= local.descripcion %></p>
                    <p class="status-note mb-0">
                        Estado mostrado según la información configurada para este local.
                    </p>
                </div>

                <div class="col-lg-5">
                    <img
                        src="<%= local.imagen %>"
                        alt="Imagen de <%= local.nombre %>"
                        class="local-banner-img"
                    >
                </div>
            </div>
        </div>
    </section>

    <main class="container local-info-section">

        <!-- INFORMACIÓN PRINCIPAL -->
        <section class="mb-5">
            <div class="section-heading">
                <div class="eyebrow">Información general</div>
                <h2>Datos del establecimiento</h2>
                <p>Conoce dónde se encuentra el local, cuál es su horario y qué tipo de propuesta ofrece.</p>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <article class="info-card">
                        <div class="info-icon">📍</div>
                        <h3>Ubicación</h3>
                        <p><%= local.ubicacion %></p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="info-card">
                        <div class="info-icon">🕒</div>
                        <h3>Horario de atención</h3>
                        <p><%= local.horario %></p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="info-card">
                        <div class="info-icon">☕</div>
                        <h3>Tipo de establecimiento</h3>
                        <p><%= local.tipo || localBase.tipo %></p>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <article class="info-card">
                        <div class="info-icon">⏱️</div>
                        <h3>Tiempo aproximado</h3>
                        <p><%= local.tiempo || localBase.tiempo %></p>
                    </article>
                </div>
            </div>
        </section>

        <!-- DESCRIPCIÓN AMPLIADA -->
        <section class="row g-3 mb-5">
            <div class="col-lg-7">
                <article class="description-card">
                    <h3>Acerca de este local</h3>
                    <p><%= local.descripcionLarga || localBase.descripcionLarga %></p>
                </article>
            </div>
            <div class="col-lg-5">
                <article class="description-card">
                    <h3>¿Qué lo caracteriza?</h3>
                    <p><%= local.caracteristica || localBase.caracteristica %></p>
                    <p class="mt-3"><%= local.ambiente || localBase.ambiente %></p>
                </article>
            </div>
        </section>


    </main>

    <!-- FOOTER -->
    <%- include('../partials/Home/_footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
